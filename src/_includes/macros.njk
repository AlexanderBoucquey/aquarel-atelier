{% macro artImage(image, alt, sizes, loading = 'lazy', preferred = 960) -%}
<img src="{{ image | imgSrc(preferred) }}" srcset="{{ image | srcset }}" sizes="{{ sizes }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ alt }}" loading="{{ loading }}" decoding="async">
{%- endmacro %}

{% macro aspect(work) %}{{ (work.image.width / work.image.height) | round(3) }}{% endmacro %}

{% macro heroFigure(work, lang) -%}
<a class="hero__image" href="{{ 'work' | pageUrl(lang, work.id) }}">{{ artImage(work.image, work.alt[lang], '(min-width: 1200px) 1136px, 100vw', 'eager', 1600) }}</a>
{%- if work.title[lang] %}
<p class="hero__caption">{{ work.title[lang] }}{% if work.meta[lang] %} · {{ work.meta[lang] }}{% endif %}</p>
{%- endif %}
{%- endmacro %}

{# A subject on the home page: one of its works, the subject's name and how many works it has. #}
{% macro subjectCard(work, s, lang, t) -%}
<a href="{{ 'work' | pageUrl(lang) }}?onderwerp={{ s.key }}">
  {{ artImage(work.image, work.alt[lang], work.image | tileSizes) }}
  <span class="subject__name">{{ s.plural[lang] }}</span>
  <span class="subject__count">{{ s.count }} {{ t.home.work if s.count == 1 else t.home.works }}</span>
</a>
{%- endmacro %}

{% macro workTile(work, lang) -%}
<li class="tile" style="--ar: {{ aspect(work) }}" data-subject="{{ work.subject.key if work.subject else '' }}" data-technique="{{ work.technique.key if work.technique else '' }}"{% if work.award.nl %} data-award{% endif %}>
  <a href="{{ 'work' | pageUrl(lang, work.id) }}">{{ artImage(work.image, work.alt[lang], work.image | tileSizes) }}</a>
</li>
{%- endmacro %}

{% macro exhibition(e, lang, t) -%}
<article class="ex" id="e-{{ e.key }}">
  {%- if e.image %}
  <div class="ex__image">{{ artImage(e.image, e.title[lang], '(min-width: 600px) 180px, 100vw', 'lazy', 480) }}</div>
  {%- endif %}
  <div class="ex__body">
    {%- if e.from or e.to %}
    <p class="meta">{{ e.from | dateRange(e.to, lang) }}</p>
    {%- endif %}
    {%- if e.title[lang] %}
    <h3>{{ e.title[lang] }}</h3>
    {%- endif %}
    {%- if e.place or e.address %}
    <p class="ex__place">{{ e.place }}{% if e.place and e.address %}<br>{% endif %}{{ e.address }}</p>
    {%- endif %}
    {{ e.text[lang] | paragraphs | safe }}
    {%- if e.pdf %}
    <p><a href="/pdf/{{ e.pdf.file }}">{{ t.exhibitions.pdf }}</a></p>
    {%- elif e.link %}
    <p><a href="{{ e.link }}" rel="noopener">{{ t.exhibitions.moreInfo }}</a></p>
    {%- endif %}
  </div>
</article>
{%- endmacro %}
