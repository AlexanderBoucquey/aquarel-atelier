---
layout: base.njk
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ 'home' | pageUrl(lang) }}"
pageKey: home
---
{%- import "macros.njk" as m -%}
{%- set t = i18n[lang] -%}
{#- Where a subject has a choice (data-pick), each candidate sits in a <template> and the script at the bottom shows one
    at random per visit; without JavaScript the <noscript> copy of the first candidate shows. -#}
{%- if atelier.texts.home_intro %}
<section class="intro wrap-narrow">{{ atelier.texts.home_intro[lang] | paragraphs | safe }}</section>
{%- endif %}
{%- if atelier.banner %}
{%- set e = atelier.banner %}
<div class="wrap-narrow">
  <section class="event-card" data-event-card{% if e.end %} data-until="{{ e.end }}"{% endif %}>
    {%- if e.image %}
    {{ m.artImage(e.image, e.title[lang], '(min-width: 600px) 200px, 100vw', 'lazy', 480) }}
    {%- endif %}
    <div>
      <p class="eyebrow">{{ t.banner.label }}</p>
      {%- if e.title[lang] %}
      <h2>{{ e.title[lang] }}</h2>
      {%- endif %}
      <p class="meta">{{ e.from | dateRange(e.to, lang) }}{% if e.place %} · {{ e.place }}{% endif %}</p>
      <p><a href="{{ 'exhibitions' | pageUrl(lang) }}#e-{{ e.key }}">{{ t.exhibitions.moreInfo }}</a></p>
    </div>
  </section>
</div>
{%- endif %}
{%- if atelier.works.length %}
<section class="wrap">
  {%- if atelier.subjects.length %}
  <h2 class="visually-hidden">{{ t.home.bySubject }}</h2>
  <ul class="subjects">
    {%- for s in atelier.subjects %}
    {%- set first = s.picks[0] %}
    {%- if s.picks.length > 1 %}
    <li class="subject" style="--ar: {{ m.aspect(first) }}" data-pick>
      <noscript>{{ m.subjectCard(first, s, lang, t) }}</noscript>
      {%- for w in s.picks %}
      <template data-work="{{ w.id }}" data-ar="{{ m.aspect(w) }}">{{ m.subjectCard(w, s, lang, t) }}</template>
      {%- endfor %}
    </li>
    {%- else %}
    <li class="subject" style="--ar: {{ m.aspect(first) }}" data-shown="{{ first.id }}">{{ m.subjectCard(first, s, lang, t) }}</li>
    {%- endif %}
    {%- endfor %}
  </ul>
  {%- endif %}
  <p class="more"><a href="{{ 'work' | pageUrl(lang) }}">{{ t.home.allWork }} →</a></p>
</section>
{%- else %}
<p class="wrap empty">{{ t.work.empty }}</p>
{%- endif %}
<script>
  // Runs while the page loads, so the chosen works appear at once. A work already on the page is not picked twice.
  (function () {
    var used = {};
    document.querySelectorAll('[data-shown]').forEach(function (el) {
      used[el.dataset.shown] = true;
    });
    document.querySelectorAll('[data-pick]').forEach(function (box) {
      var all = Array.prototype.slice.call(box.querySelectorAll('template'));
      var fresh = all.filter(function (tpl) {
        return !used[tpl.dataset.work];
      });
      var pool = fresh.length ? fresh : all;
      var chosen = pool[Math.floor(Math.random() * pool.length)];
      used[chosen.dataset.work] = true;
      if (chosen.dataset.ar) box.style.setProperty('--ar', chosen.dataset.ar);
      box.replaceChildren(chosen.content.cloneNode(true));
    });
  })();
</script>
