---
layout: base.njk
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ 'about' | pageUrl(lang) }}"
pageKey: about
---
{%- set t = i18n[lang] -%}
<div class="wrap">
  <h1 class="page-title">{{ t.about.heading }}</h1>
  <div class="about">
    <img class="about__portrait" src="/assets/img/portrait.webp" width="{{ site.portrait.width }}" height="{{ site.portrait.height }}" alt="{{ t.about.portraitAlt }}">
    <div class="about__text">
      {%- if atelier.texts.about %}
      {{ atelier.texts.about[lang] | paragraphs | safe }}
      {%- endif %}
    </div>
    <div class="about__atelier">
      {%- for photo in site.atelier %}
      <img src="/assets/img/{{ photo.name }}-w600.webp" srcset="/assets/img/{{ photo.name }}-w600.webp 600w, /assets/img/{{ photo.name }}-w1200.webp 1200w" sizes="(min-width: 1200px) 552px, (min-width: 600px) 50vw, 100vw" width="1200" height="1600" alt="{{ photo.alt[lang] }}" loading="lazy" decoding="async">
      {%- endfor %}
    </div>
  </div>
</div>
